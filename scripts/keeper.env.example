# Required
RPC_URL=https://your-monad-rpc
PRIVATE_KEY=0xyour_private_key
POOL_ADDRESS=0xyour_pool_address
# Optional deploy helper: scripts/deploy-ticket-prize-pool-shmon-v2.js calls setKeeper when set.
KEEPER_ADDRESS=
# Optional multi-pool mode. POOL_ADDRESSES overrides POOL_ADDRESS when set.
POOL_ADDRESSES=
# V2 pools that use commit(rid) / settle(rid) dispatch.
POOL_ADDRESSES_V2=
# V3 VRF pools that use executeNext() plus VRF monitoring. Do not also list these in POOL_ADDRESSES_V2.
POOL_ADDRESSES_V3=
# Boot-fail unless POOL_ADDRESSES matches deployments/monad-mainnet.json keeper.activePoolAddresses.
KEEPER_POOL_RECONCILE=true
KEEPER_POOL_MANIFEST=

# Optional
KEEPER_INTERVAL_MS=30000
KEEPER_DRY_RUN=false
KEEPER_GAS_LIMIT=
KEEPER_MAX_FEE_GWEI=
KEEPER_MAX_PRIORITY_FEE_GWEI=

# Keeper safety/alerts
KEEPER_LOW_BALANCE_MON=0.2
VRF_TIMEOUT_SEC=3600
VRF_LOW_RESERVE_MON=0.05
KEEPER_ERROR_ALERT_THRESHOLD=3
KEEPER_ALERT_REPEAT_MS=3600000
KEEPER_BALANCE_LOG_EVERY_TICKS=20
KEEPER_HEARTBEAT_LOG_EVERY_TICKS=10
KEEPER_PREFLIGHT=true

# Independent dead-man heartbeats (healthchecks.io or compatible).
# Store real URLs as Fly secrets, not in git.
KEEPER_HEALTHCHECK_URL=
KEEPER_HEALTHCHECK_FAIL_URL=
KEEPER_HEALTHCHECK_MS=300000
ALERT_WATCHER_HEALTHCHECK_URL=
ALERT_WATCHER_HEALTHCHECK_FAIL_URL=
KEEPER_WATCHDOG_HEALTHCHECK_URL=
KEEPER_WATCHDOG_HEALTHCHECK_FAIL_URL=
HEALTHCHECK_TIMEOUT_MS=8000

# Alert watcher checks
ALERT_WATCHER_VRF_CHECK_MS=3600000
ALERT_WATCHER_ACTION_OVERDUE_MS=600000
ALERT_WATCHER_ACTION_OVERDUE_CHECK_MS=60000
VRF_LOW_THRESHOLD_MON=5
VRF_FEE_ESTIMATE_MON=0.05

# Telegram alerts (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=8000
TELEGRAM_RETRIES=2
